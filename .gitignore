# 依赖与构建产物
node_modules/
dist/
out/
release/
# 打包图标集是中间产物，build/icon.icns 才是要提交的资源
build/*.iconset/

# 根目录的界面截图（开发取证用，不进仓库；renderer/assets 里的资源要保留）
/*.png
/*.jpg

# 工作区：截图归档与临时草稿不进仓库（notes/ 设计文档进仓库）
docs/screenshots/
scratch/

# 系统 / 编辑器噪声
.DS_Store
*.log
npm-debug.log*
.idea/

# 本机脚手架：git worktree 检出目录与 WorkBuddy 会话数据
.worktrees/
.workbuddy/

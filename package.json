{
  "name": "hermes-desktop-client",
  "productName": "Hermes Desktop Client",
  "version": "0.1.0",
  "description": "dsh 风格的 Hermes Agent CLI 桌面客户端",
  "main": "main/main.js",
  "author": "WorkBuddy User",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/fix-pty-perm.js",
    "test": "node scripts/test-services.js && node scripts/test-contracts.js && node scripts/check-package.js",
    "test:ui": "node scripts/test-ui.js",
    "test:services": "node scripts/test-services.js",
    "test:contracts": "node scripts/test-contracts.js",
    "pack:check": "node scripts/check-package.js",
    "dist": "node scripts/dist.js",
    "dist:dir": "node scripts/dist.js --mac --dir",
    "dist:mac": "node scripts/dist.js --mac",
    "dist:win": "node scripts/dist.js --win",
    "dist:linux": "node scripts/dist.js --linux"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}

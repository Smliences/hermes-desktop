{
  "name": "hermes-desktop-client",
  "productName": "Hermes Desktop Client",
  "version": "0.1.0",
  "description": "dsh 风格的 Hermes Agent CLI 桌面客户端",
  "main": "main/main.js",
  "author": "WorkBuddy User",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/test-services.js && node scripts/test-contracts.js",
    "test:services": "node scripts/test-services.js",
    "test:contracts": "node scripts/test-contracts.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
